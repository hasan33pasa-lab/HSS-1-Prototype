// Tang Nano 20K: 27 MHz crystal on PIN04; six active-low LEDs on PIN15-20.
IO_LOC "clk_27mhz" 4;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33;
IO_LOC "key1_reset" 88;
IO_PORT "key1_reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "key2_stall_test" 87;
IO_PORT "key2_stall_test" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;
